{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/policy-evaluation.schema.json",
  "title": "Read-only policy evaluation; never execution authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding", "requirements", "results"],
  "properties": {
    "schema_version": { "const": 1 },
    "binding": { "$ref": "#/$defs/binding" },
    "requirements": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule_id", "mandatory"],
        "properties": { "rule_id": { "$ref": "#/$defs/id" }, "mandatory": { "type": "boolean" } }
      }
    },
    "results": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule_id", "binding", "decision", "code"],
        "properties": {
          "rule_id": { "$ref": "#/$defs/id" },
          "binding": { "$ref": "#/$defs/binding" },
          "decision": { "enum": ["allow", "deny", "unsupported", "error"] },
          "code": { "$ref": "#/$defs/id" },
          "evidence_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "policy_digest", "target_digest"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/id" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "target_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
