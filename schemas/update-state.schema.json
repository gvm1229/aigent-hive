{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigent-hive.local/schemas/update-state.schema.json",
  "title": "Aigent Hive installed release state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_version", "release_manifest_digest", "accepted_release"],
  "properties": {
    "schema_version": { "const": 1 },
    "product_version": { "$ref": "#/$defs/version" },
    "release_manifest_digest": { "$ref": "#/$defs/digest" },
    "accepted_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_version", "release_sequence", "manifest_digest"],
      "properties": {
        "release_version": { "$ref": "#/$defs/version" },
        "release_sequence": { "type": "integer", "minimum": 1 },
        "manifest_digest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
