{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/knowledge-lint-result.schema.json",
  "title": "Aigent Hive knowledge lint data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issues",
    "error_count",
    "warning_count",
    "shared_index_digest",
    "shared_index_path"
  ],
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "locator", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["error", "warning"] },
          "locator": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "error_count": { "type": "integer", "minimum": 0 },
    "warning_count": { "type": "integer", "minimum": 0 },
    "shared_index_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "shared_index_path": {
      "anyOf": [
        { "const": ".hive/index/hive.sqlite3" },
        { "type": "null" }
      ]
    }
  }
}
