{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/custom-subagent-profile.schema.json",
  "title": "Aigent Hive custom subagent profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role_id", "display_name", "description", "scope", "reserved", "permission", "positive_triggers", "negative_triggers", "host_mappings", "definition_digest"],
  "properties": {
    "schema_version": { "const": 1 },
    "role_id": { "$ref": "#/$defs/id" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\r\\n]+$" },
    "description": { "type": "string", "minLength": 8, "maxLength": 500, "pattern": "^[^\\r\\n]+$" },
    "scope": { "enum": ["user", "project"] },
    "reserved": { "type": "boolean" },
    "permission": { "enum": ["read-only", "bounded-write"] },
    "positive_triggers": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/trigger" } },
    "negative_triggers": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/trigger" } },
    "host_mappings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude"],
      "properties": {
        "codex": { "$ref": "#/$defs/mapping" },
        "claude": { "$ref": "#/$defs/mapping" }
      }
    },
    "definition_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "trigger": { "type": "string", "minLength": 2, "maxLength": 100, "pattern": "^[^\\r\\n]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort", "minimum_version"],
      "properties": {
        "model": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,80}$" },
        "effort": { "enum": ["low", "medium", "high", "max"] },
        "minimum_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    }
  }
}
