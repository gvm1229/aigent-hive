{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Bounded host semantic result",
  "required": [
    "schema_version",
    "request_digest",
    "processed_ids",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "processed_ids": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind",
          "evidence",
          "start",
          "end",
          "text_digest",
          "source_digest",
          "target_digest"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "enum": [
              "related",
              "supports",
              "contradicts",
              "depends-on"
            ]
          },
          "evidence": {
            "enum": [
              "EXTRACTED",
              "INFERRED"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16384
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "text_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "source_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "target_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
