{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigent-hive.local/schemas/historical-builtins.schema.json",
  "title": "Aigent Hive historical built-in Skill authentication registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "releases"],
  "properties": {
    "schema_version": { "const": 1 },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "skills"],
        "properties": {
          "version": { "$ref": "#/$defs/version" },
          "skills": {
            "type": "array",
            "items": { "$ref": "#/$defs/skill" }
          }
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "content_digest", "side_effect_class", "capabilities"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "content_digest": { "$ref": "#/$defs/digest" },
        "side_effect_class": {
          "enum": ["none", "read-only", "project-write", "external-write", "orchestration"]
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "external-app",
              "filesystem-read",
              "filesystem-write",
              "memory-read",
              "memory-write",
              "network",
              "run-state",
              "shell",
              "subagents"
            ]
          }
        }
      }
    }
  }
}
