{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigent-hive.dev/schemas/project-skill-merge.schema.json",
  "title": "Reviewed project Skill merge",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_version", "project_base_digest", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "product_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "project_base_digest": {"$ref": "#/$defs/digest"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "local_digest", "incoming_digest", "merged_content"],
        "properties": {
          "path": {"type": "string", "pattern": "^\\.(agents|claude)/skills/[a-z][a-z0-9-]*/.+$"},
          "local_digest": {"$ref": "#/$defs/digest"},
          "incoming_digest": {"$ref": "#/$defs/digest"},
          "merged_content": {"type": "string", "minLength": 1, "maxLength": 1048576}
        }
      }
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
