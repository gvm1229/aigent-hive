{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/knowledge-query-result.schema.json",
  "title": "Aigent Hive knowledge query data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hits",
    "project_hit_count",
    "root_hit_count",
    "precedence"
  ],
  "properties": {
    "project_hit_count": { "type": "integer", "minimum": 0 },
    "root_hit_count": { "type": "integer", "minimum": 0 },
    "cross_project_hit_count": { "type": "integer", "minimum": 0 },
    "precedence": {
      "enum": ["project-first", "own-project,user-root,shared"]
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "summary",
          "path",
          "content_digest",
          "tags",
          "aliases",
          "sources"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "content_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^raw:\\.hive/knowledge/Raw/[A-Za-z0-9._/-]+#sha256:[0-9a-f]{64}$"
            }
          },
          "scope": { "enum": ["project", "user-root"] },
          "provenance": {
            "enum": ["project-local", "explicit-promotion"]
          },
          "source_project": { "type": "string", "minLength": 1 },
          "page_id": { "type": "string", "minLength": 1 },
          "language": { "enum": ["en", "ko", "both", "und"] },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "visibility": {
            "enum": ["shared", "project-private", "confidential"]
          }
        },
        "oneOf": [
          { "required": ["scope", "provenance"] },
          {
            "required": [
              "source_project",
              "page_id",
              "language",
              "digest",
              "visibility"
            ]
          }
        ]
      }
    }
  }
}
