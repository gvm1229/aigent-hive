{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/orchestration-trust-root.schema.json",
  "title": "Aigent Hive orchestration trust root",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trust_root_id", "revision", "issued_at", "keys", "root_digest"],
  "properties": {
    "schema_version": { "const": 1 },
    "trust_root_id": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "principal_id", "algorithm", "public_key", "status", "valid_from", "valid_until", "allowed_actions"],
        "properties": {
          "key_id": { "$ref": "#/$defs/id" },
          "principal_id": { "$ref": "#/$defs/id" },
          "algorithm": { "const": "ed25519" },
          "public_key": { "type": "string", "pattern": "^ed25519:[0-9a-f]{64}$" },
          "status": { "enum": ["active", "revoked"] },
          "valid_from": { "type": "string", "format": "date-time" },
          "valid_until": { "type": "string", "format": "date-time" },
          "allowed_actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["plan", "dispatch", "receipt", "cancel", "recover", "migrate", "issue-authority", "revoke-authority"] }
          }
        }
      }
    },
    "root_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,126}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
