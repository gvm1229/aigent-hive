{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/dispatch-brief.schema.json",
  "title": "Aigent Hive provider-neutral dispatch brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_revision",
    "role_id",
    "responsibilities",
    "non_responsibilities",
    "verification_duties",
    "next_action",
    "host",
    "host_version",
    "surface",
    "external_runtime",
    "resolved_owner",
    "resolution_evidence_digest",
    "subagent_support",
    "context_paths",
    "write_scope",
    "acceptance_criteria",
    "evidence",
    "handoff_path",
    "resume_note",
    "prepared_only"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,126}$"
    },
    "run_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "role_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/roleDuty" }
    },
    "non_responsibilities": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/roleDuty" }
    },
    "verification_duties": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/roleDuty" }
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000]+$"
    },
    "host": {
      "enum": ["codex", "claude", "antigravity"]
    },
    "host_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "surface": {
      "enum": ["app", "cli", "plugin", "in-session"]
    },
    "external_runtime": {
      "type": ["string", "null"],
      "enum": ["omx", "omc", null]
    },
    "resolved_owner": {
      "enum": ["host-native", "omx", "omc"]
    },
    "resolution_evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subagent_support": {
      "enum": ["supported", "best-effort", "unsupported", "unverified"]
    },
    "context_paths": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pathSelector" }
    },
    "write_scope": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pathSelector" }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceLocator" }
    },
    "handoff_path": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "resume_note": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000]+$"
    },
    "prepared_only": {
      "const": true
    }
  },
  "$defs": {
    "roleDuty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "pathSelector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "evidenceLocator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000\\r\\n]+$"
    }
  }
}
