{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigent-hive.local/schemas/release-surface-inventory.schema.json",
  "title": "Aigent Hive shipped release surface inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_version", "schemas", "skills", "capabilities", "migrations", "templates", "ownership", "projections"],
  "properties": {
    "schema_version": { "const": 1 },
    "product_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "schemas": { "$ref": "#/$defs/nonemptyStrings" },
    "skills": { "$ref": "#/$defs/nonemptyStrings" },
    "capabilities": { "$ref": "#/$defs/nonemptyStrings" },
    "migrations": { "$ref": "#/$defs/nonemptyStrings" },
    "templates": { "$ref": "#/$defs/nonemptyStrings" },
    "ownership": { "$ref": "#/$defs/nonemptyStrings" },
    "projections": { "$ref": "#/$defs/nonemptyStrings" }
  },
  "$defs": {
    "nonemptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
