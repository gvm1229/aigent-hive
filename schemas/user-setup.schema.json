{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/user-setup.schema.json",
  "title": "Aigent Hive user setup",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interface_language",
    "wiki",
    "profile",
    "persona",
    "selected_hosts",
    "skills",
    "usage_guard"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "interface_language": { "enum": ["en", "ko"] },
    "wiki": { "$ref": "#/$defs/wiki" },
    "profile": { "$ref": "#/$defs/profile" },
    "persona": { "$ref": "#/$defs/persona" },
    "selected_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["codex", "claude", "antigravity"] }
    },
    "skills": { "$ref": "#/$defs/skill_selection" },
    "update_check": { "$ref": "#/$defs/update_check" },
    "judge_invocation": { "$ref": "#/$defs/judge_invocation" },
    "usage_guard": { "$ref": "#/$defs/usage_guard" }
  },
  "$defs": {
    "nonempty_single_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?=.*\\S)[^\\r\\n]+$"
    },
    "wiki": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "language": { "enum": ["en", "ko", "both"] },
        "backend": { "const": "markdown", "default": "markdown" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contexts"],
      "properties": {
        "contexts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["web-developer", "game-developer", "non-developer"] }
        },
        "description": { "$ref": "#/$defs/nonempty_single_line" }
      },
      "anyOf": [
        { "properties": { "contexts": { "minItems": 1 } } },
        { "required": ["description"] }
      ]
    },
    "persona": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "enum": ["strict", "balanced", "friendly"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "custom_description"],
          "properties": {
            "id": { "const": "custom" },
            "custom_description": { "$ref": "#/$defs/nonempty_single_line" }
          }
        }
      ]
    },
    "skill_name": {
      "enum": [
        "quick-answer",
        "project-setup",
        "code-polish",
        "verified-workflow",
        "knowledge-import",
        "knowledge-maintain",
        "knowledge-capture",
        "prompt-refine",
        "research-best-practices",
        "knowledge-recall",
        "usage-guard",
        "ship",
        "amend-directive",
        "humanize-kor",
        "user-setup",
        "run-handoff",
        "project-transition",
        "run-resume",
        "run-checkpoint",
        "knowledge-promote",
        "product-update",
        "project-refresh",
        "judge-evidence",
        "adversarial-judge",
        "team-execution",
        "multi-goal",
        "custom-subagent-create"
      ]
    },
    "skill_selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "all" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "selected"],
          "properties": {
            "mode": { "const": "individual" },
            "selected": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/skill_name" }
            }
          }
        }
      ]
    },
    "update_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false }
      }
    },
    "judge_invocation": {
      "enum": ["explicit", "implicit"],
      "default": "explicit"
    },
    "usage_guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "stop_remaining_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "codexbar_fallback_enabled": { "type": "boolean", "default": false },
        "project_overrides": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\r\\n\\u0000]+$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "default": {}
        },
        "discord": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "webhook_url_env": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
            },
            "request_privacy": {
              "enum": ["summary", "raw-prompt"],
              "default": "summary"
            },
            "message_fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "remaining-usage",
                  "project",
                  "request",
                  "progress",
                  "host",
                  "resume",
                  "measured-at",
                  "evidence"
                ]
              },
              "default": [
                "remaining-usage",
                "project",
                "request",
                "progress",
                "host",
                "resume"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              },
              "then": { "required": ["webhook_url_env"] }
            },
            {
              "if": {
                "properties": { "enabled": { "const": false } },
                "required": ["enabled"]
              },
              "then": { "not": { "required": ["webhook_url_env"] } }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": false } },
            "required": ["enabled"]
          },
          "then": {
            "properties": { "codexbar_fallback_enabled": { "const": false } }
          }
        }
      ],
      "required": ["stop_remaining_percent"]
    }
  }
}
