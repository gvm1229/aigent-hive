{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/user-setup.schema.json",
  "title": "Aigent Hive user setup",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interface_language",
    "wiki",
    "profile",
    "persona",
    "selected_hosts",
    "skills",
    "usage_guard"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "interface_language": {
      "enum": [
        "en",
        "ko"
      ]
    },
    "wiki": {
      "$ref": "#/$defs/wiki"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "persona": {
      "$ref": "#/$defs/persona"
    },
    "selected_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "codex",
          "claude",
          "antigravity"
        ]
      }
    },
    "skills": {
      "$ref": "#/$defs/skill_selection"
    },
    "update_check": {
      "$ref": "#/$defs/update_check"
    },
    "judge_invocation": {
      "$ref": "#/$defs/judge_invocation"
    },
    "usage_guard": {
      "type": "object"
    },
    "preference_decisions": {
      "$ref": "#/$defs/preference_decisions"
    }
  },
  "$defs": {
    "nonempty_single_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?=.*\\S)[^\\r\\n]+$"
    },
    "wiki": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "language": {
          "enum": [
            "en",
            "ko",
            "both"
          ]
        },
        "backend": {
          "const": "markdown",
          "default": "markdown"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contexts"
      ],
      "properties": {
        "contexts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "web-developer",
              "game-developer",
              "non-developer"
            ]
          }
        },
        "description": {
          "$ref": "#/$defs/nonempty_single_line"
        }
      },
      "anyOf": [
        {
          "properties": {
            "contexts": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "description"
          ]
        }
      ]
    },
    "persona": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "enum": [
                "strict",
                "balanced",
                "friendly"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "custom_description"
          ],
          "properties": {
            "id": {
              "const": "custom"
            },
            "custom_description": {
              "$ref": "#/$defs/nonempty_single_line"
            }
          }
        }
      ]
    },
    "skill_name": {
      "enum": [
        "quick-answer",
        "project-setup",
        "code-polish",
        "verified-workflow",
        "knowledge-scan",
        "knowledge-transfer",
        "knowledge-maintain",
        "knowledge-capture",
        "prompt-refine",
        "research-best-practices",
        "knowledge-recall",
        "usage-guard",
        "ship",
        "amend-directive",
        "humanize-kor",
        "user-setup",
        "run-handoff",
        "project-transition",
        "run-resume",
        "run-checkpoint",
        "knowledge-promote",
        "product-update",
        "project-refresh",
        "judge-evidence",
        "adversarial-judge",
        "team-execution",
        "multi-goal",
        "custom-subagent-create"
      ]
    },
    "skill_selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "all"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "selected"
          ],
          "properties": {
            "mode": {
              "const": "individual"
            },
            "selected": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/skill_name"
              }
            }
          }
        }
      ]
    },
    "update_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "judge_invocation": {
      "enum": [
        "explicit",
        "implicit"
      ],
      "default": "explicit"
    },
    "usage_guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "stop_remaining_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "codexbar_fallback_enabled": {
          "type": "boolean",
          "default": false
        },
        "quota_reset_guard_enabled": {
          "type": "boolean",
          "default": true
        },
        "project_overrides": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\r\\n\\u0000]+$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "default": {}
        },
        "discord": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "webhook_url_env": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
            },
            "request_privacy": {
              "enum": [
                "summary",
                "raw-prompt"
              ],
              "default": "summary"
            },
            "message_fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "remaining-usage",
                  "project",
                  "request",
                  "progress",
                  "host",
                  "resume",
                  "measured-at",
                  "evidence"
                ]
              },
              "default": [
                "remaining-usage",
                "project",
                "request",
                "progress",
                "host",
                "resume"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "required": [
                  "webhook_url_env"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": false
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "webhook_url_env"
                  ]
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": false
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "codexbar_fallback_enabled": {
                "const": false
              }
            }
          }
        }
      ],
      "required": [
        "stop_remaining_percent"
      ]
    },
    "preference_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "input_channel",
        "scope",
        "question_id",
        "question_revision",
        "policy_version",
        "changed_in_version",
        "decided_at",
        "value_digest"
      ],
      "properties": {
        "origin": {
          "enum": [
            "default",
            "explicit",
            "accepted-default",
            "inherited",
            "legacy-unknown",
            "external-change"
          ]
        },
        "input_channel": {
          "enum": [
            "terminal",
            "answers-file",
            "agent",
            "migration"
          ]
        },
        "scope": {
          "enum": [
            "user",
            "project"
          ]
        },
        "question_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "question_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "changed_in_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "decided_at": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "value_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "inherited_from": {
          "type": "object",
          "required": [
            "scope",
            "key"
          ],
          "properties": {
            "scope": {
              "const": "user"
            },
            "key": {
              "type": "string",
              "pattern": "^/[^\\r\\n]+$",
              "maxLength": 512
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "inherited"
              }
            }
          },
          "then": {
            "required": [
              "inherited_from"
            ],
            "properties": {
              "scope": {
                "const": "project"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "inherited_from"
              ]
            }
          }
        }
      ]
    },
    "preference_decisions": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {
        "type": "string",
        "pattern": "^/[^\\r\\n\\u0000]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/preference_decision"
      }
    },
    "usage_guard_v2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stop_remaining_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "codexbar_fallback_enabled": {
          "type": "boolean",
          "default": false
        },
        "project_overrides": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\r\\n\\u0000]+$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "default": {}
        },
        "discord": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "webhook_url_env": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
            },
            "request_privacy": {
              "enum": [
                "summary",
                "raw-prompt"
              ],
              "default": "summary"
            },
            "message_fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "remaining-usage",
                  "project",
                  "request",
                  "progress",
                  "host",
                  "resume",
                  "measured-at",
                  "evidence"
                ]
              },
              "default": [
                "remaining-usage",
                "project",
                "request",
                "progress",
                "host",
                "resume"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "required": [
                  "webhook_url_env"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": false
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "webhook_url_env"
                  ]
                }
              }
            }
          ]
        },
        "enforcement_enabled": {
          "type": "boolean"
        },
        "warnings_enabled": {
          "type": "boolean"
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold_enabled": {
              "type": "boolean"
            },
            "reset_enabled": {
              "type": "boolean"
            },
            "zero_quota_enabled": {
              "type": "boolean"
            },
            "observation_failure": {
              "enum": [
                "warn",
                "block"
              ]
            }
          },
          "required": [
            "threshold_enabled",
            "reset_enabled",
            "zero_quota_enabled",
            "observation_failure"
          ]
        },
        "midway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "threshold_enabled": {
              "type": "boolean"
            },
            "reset_enabled": {
              "type": "boolean"
            },
            "zero_quota_enabled": {
              "type": "boolean"
            },
            "observation_failure": {
              "enum": [
                "warn",
                "stop"
              ]
            }
          },
          "required": [
            "enabled",
            "threshold_enabled",
            "reset_enabled",
            "zero_quota_enabled",
            "observation_failure"
          ]
        },
        "popup_enabled": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "stop_remaining_percent",
        "enforcement_enabled",
        "warnings_enabled",
        "preflight",
        "midway"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "usage_guard": {
            "$ref": "#/$defs/usage_guard"
          }
        }
      },
      "else": {
        "properties": {
          "usage_guard": {
            "$ref": "#/$defs/usage_guard_v2"
          }
        }
      }
    }
  ]
}
