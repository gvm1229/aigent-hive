{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/user-setup.schema.json",
  "title": "Aigent Hive user setup",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interface_language",
    "wiki",
    "profile",
    "persona",
    "selected_hosts",
    "skills",
    "usage_guard"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "interface_language": { "enum": ["en", "ko"] },
    "wiki": { "$ref": "#/$defs/wiki" },
    "profile": { "$ref": "#/$defs/profile" },
    "persona": { "$ref": "#/$defs/persona" },
    "selected_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["codex", "claude", "antigravity"] }
    },
    "skills": { "$ref": "#/$defs/skill_selection" },
    "update_check": { "$ref": "#/$defs/update_check" },
    "usage_guard": { "$ref": "#/$defs/usage_guard" }
  },
  "$defs": {
    "nonempty_single_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?=.*\\S)[^\\r\\n]+$"
    },
    "wiki": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "language": { "enum": ["en", "ko", "both"] },
        "backend": { "enum": ["markdown", "notion"], "default": "markdown" },
        "notion": { "$ref": "#/$defs/notion_wiki" }
      },
      "allOf": [
        {
          "if": { "properties": { "backend": { "const": "notion" } }, "required": ["backend"] },
          "then": {
            "required": ["notion"],
            "properties": { "enabled": { "const": true } }
          },
          "else": { "not": { "required": ["notion"] } }
        }
      ]
    },
    "notion_wiki": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "scope_id", "local_index_consent"],
      "properties": {
        "workspace_id": { "$ref": "#/$defs/nonempty_single_line" },
        "scope_id": { "$ref": "#/$defs/nonempty_single_line" },
        "local_index_consent": { "const": true }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contexts"],
      "properties": {
        "contexts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["web-developer", "game-developer", "non-developer"] }
        },
        "description": { "$ref": "#/$defs/nonempty_single_line" }
      },
      "anyOf": [
        { "properties": { "contexts": { "minItems": 1 } } },
        { "required": ["description"] }
      ]
    },
    "persona": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "enum": ["strict", "balanced", "friendly"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "custom_description"],
          "properties": {
            "id": { "const": "custom" },
            "custom_description": { "$ref": "#/$defs/nonempty_single_line" }
          }
        }
      ]
    },
    "skill_name": {
      "enum": [
        "configure",
        "setup-project",
        "auto-setup-project",
        "clean-ai-slop",
        "research-practices",
        "engineer-run",
        "manage-wiki",
        "answer",
        "refine-prompt",
        "record-knowledge",
        "search-knowledge",
        "import-repository-knowledge",
        "share-knowledge",
        "maintain-knowledge",
        "save-progress",
        "resume-work",
        "manage-usage",
        "handoff-role",
        "verify-package",
        "update-hive",
        "upgrade-project",
        "migrate-project"
      ]
    },
    "skill_selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "all" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "selected"],
          "properties": {
            "mode": { "const": "individual" },
            "selected": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/skill_name" }
            }
          }
        }
      ]
    },
    "update_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false }
      }
    },
    "usage_guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "stop_remaining_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "default": 20
        },
        "codexbar_fallback_enabled": { "type": "boolean", "default": false },
        "discord": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "webhook_url_env": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
            },
            "request_privacy": {
              "enum": ["summary", "raw-prompt"],
              "default": "summary"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              },
              "then": { "required": ["webhook_url_env"] }
            },
            {
              "if": {
                "properties": { "enabled": { "const": false } },
                "required": ["enabled"]
              },
              "then": { "not": { "required": ["webhook_url_env"] } }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": false } },
            "required": ["enabled"]
          },
          "then": {
            "properties": { "codexbar_fallback_enabled": { "const": false } }
          }
        }
      ]
    }
  }
}
