{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/orchestration-authority.schema.json",
  "title": "Aigent Hive orchestration single-action authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "authority_id", "trust_root_id", "principal_id", "role_id",
    "action", "target_digest", "expected_head", "control_epoch", "request_digest",
    "nonce", "issued_at", "valid_until", "key_id", "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "authority_id": { "$ref": "#/$defs/id" },
    "trust_root_id": { "$ref": "#/$defs/id" },
    "principal_id": { "$ref": "#/$defs/id" },
    "role_id": { "$ref": "#/$defs/id" },
    "action": { "enum": ["plan", "dispatch", "receipt", "cancel", "recover", "migrate", "issue-authority", "revoke-authority"] },
    "target_digest": { "$ref": "#/$defs/digest" },
    "expected_head": { "oneOf": [{ "const": "none" }, { "$ref": "#/$defs/head" }] },
    "control_epoch": { "type": "integer", "minimum": 0 },
    "request_digest": { "$ref": "#/$defs/digest" },
    "nonce": { "$ref": "#/$defs/id" },
    "issued_at": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "key_id": { "$ref": "#/$defs/id" },
    "signature": { "type": "string", "pattern": "^ed25519:[0-9a-f]{128}$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,126}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "head": { "type": "string", "pattern": "^[0-9]+:sha256:[0-9a-f]{64}$" }
  }
}
