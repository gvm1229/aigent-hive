{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/host-model-catalog.schema.json",
  "title": "Aigent Hive externally signed host model catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "principal_id", "issued_at", "models"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "model", "efforts", "minimum_version"],
        "properties": {
          "host": { "enum": ["codex", "claude"] },
          "model": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,80}$" },
          "efforts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["low", "medium", "high", "max"] }
          },
          "minimum_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
        }
      }
    }
  }
}
