{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/judge-assignment.schema.json",
  "title": "Aigent Hive judge assignment",
  "description": "Owner-attested roster sealed before verdict production. assignment_digest is SHA-256 over the RFC 8785/JCS encoding with assignment_digest excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_id",
    "package_digest",
    "acceptance_criteria",
    "requester_id",
    "task_agent_id",
    "resolved_owner_id",
    "owner_provenance",
    "slots",
    "created_at",
    "assignment_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "package_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requester_id": { "type": "string", "minLength": 1 },
    "task_agent_id": { "type": "string", "minLength": 1 },
    "resolved_owner_id": { "type": "string", "minLength": 1 },
    "owner_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "authentication_evidence_digest"],
      "properties": {
        "authority": {
          "enum": ["host-session", "external-orchestrator"]
        },
        "authentication_evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "judge_instance_id",
          "eligibility_evidence_digest"
        ],
        "properties": {
          "slot_id": { "type": "string", "minLength": 1 },
          "judge_instance_id": { "type": "string", "minLength": 1 },
          "eligibility_evidence_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "assignment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
