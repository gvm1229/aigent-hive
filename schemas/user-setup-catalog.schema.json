{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/user-setup-catalog.schema.json",
  "title": "Aigent Hive signed user setup catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profiles",
    "personas",
    "mandatory_skills",
    "skill_dependencies",
    "optional_third_party_skills"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/web_profile" },
        { "$ref": "#/$defs/game_profile" },
        { "$ref": "#/$defs/non_developer_profile" }
      ],
      "items": false
    },
    "personas": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/strict_persona" },
        { "$ref": "#/$defs/balanced_persona" },
        { "$ref": "#/$defs/friendly_persona" },
        { "$ref": "#/$defs/custom_persona" }
      ],
      "items": false
    },
    "mandatory_skills": { "const": ["user-setup"] },
    "skill_dependencies": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/skill_dependency" }
    },
    "optional_third_party_skills": {
      "description": "Reserved signed-consent boundary. Empty means this release cannot activate third-party Skills.",
      "const": []
    }
  },
  "$defs": {
    "localized_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ko"],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\r\\n]+$" },
        "ko": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\r\\n]+$" }
      }
    },
    "catalog_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "description"],
      "properties": {
        "id": { "type": "string" },
        "display_name": { "$ref": "#/$defs/localized_text" },
        "description": { "$ref": "#/$defs/localized_text" }
      }
    },
    "web_profile": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "web-developer" } } }
      ]
    },
    "game_profile": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "game-developer" } } }
      ]
    },
    "non_developer_profile": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "non-developer" } } }
      ]
    },
    "strict_persona": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "strict" } } }
      ]
    },
    "balanced_persona": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "balanced" } } }
      ]
    },
    "friendly_persona": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "friendly" } } }
      ]
    },
    "custom_persona": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "custom" } } }
      ]
    },
    "skill_name": {
      "enum": [
        "quick-answer",
        "project-setup",
        "code-polish",
        "verified-workflow",
        "knowledge-import",
        "knowledge-maintain",
        "knowledge-capture",
        "prompt-refine",
        "research-best-practices",
        "knowledge-recall",
        "usage-guard",
        "ship",
        "amend-directive",
        "humanize-kor",
        "user-setup",
        "run-handoff",
        "project-transition",
        "run-resume",
        "run-checkpoint",
        "knowledge-promote",
        "product-update",
        "project-refresh",
        "judge-evidence",
        "adversarial-judge",
        "team-execution",
        "multi-goal",
        "custom-subagent-create"
      ]
    },
    "skill_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "requires"],
      "properties": {
        "skill": { "$ref": "#/$defs/skill_name" },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/skill_name" }
        }
      }
    }
  }
}
