{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/user-setup-catalog.schema.json",
  "title": "Aigent Hive signed user setup catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profiles",
    "personas",
    "mandatory_skills",
    "skill_dependencies",
    "optional_third_party_skills"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/web_profile" },
        { "$ref": "#/$defs/game_profile" },
        { "$ref": "#/$defs/non_developer_profile" },
        { "$ref": "#/$defs/custom_profile" }
      ],
      "items": false
    },
    "personas": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/strict_persona" },
        { "$ref": "#/$defs/balanced_persona" },
        { "$ref": "#/$defs/friendly_persona" },
        { "$ref": "#/$defs/custom_persona" }
      ],
      "items": false
    },
    "mandatory_skills": { "const": ["setup-hive"] },
    "skill_dependencies": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/skill_dependency" }
    },
    "optional_third_party_skills": {
      "description": "Reserved signed-consent boundary. Empty means this release cannot activate third-party Skills.",
      "const": []
    }
  },
  "$defs": {
    "localized_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ko"],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\r\\n]+$" },
        "ko": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\r\\n]+$" }
      }
    },
    "catalog_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "description"],
      "properties": {
        "id": { "type": "string" },
        "display_name": { "$ref": "#/$defs/localized_text" },
        "description": { "$ref": "#/$defs/localized_text" }
      }
    },
    "web_profile": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "web-developer" } } }
      ]
    },
    "game_profile": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "game-developer" } } }
      ]
    },
    "non_developer_profile": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "non-developer" } } }
      ]
    },
    "custom_profile": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "custom" } } }
      ]
    },
    "strict_persona": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "strict" } } }
      ]
    },
    "balanced_persona": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "balanced" } } }
      ]
    },
    "friendly_persona": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "friendly" } } }
      ]
    },
    "custom_persona": {
      "allOf": [
        { "$ref": "#/$defs/catalog_entry" },
        { "properties": { "id": { "const": "custom" } } }
      ]
    },
    "skill_name": {
      "enum": [
        "setup-hive",
        "setup-harness",
        "auto-setup-harness",
        "ai-slop-cleaner",
        "best-practice-research",
        "hive-loop-engineering",
        "hive-wiki",
        "hive-simple-question",
        "hive-prompt-refine",
        "hive-knowledge-capture",
        "hive-knowledge-query",
        "hive-knowledge-scan",
        "hive-knowledge-promote",
        "hive-knowledge-maintenance",
        "hive-run-checkpoint",
        "hive-run-resume",
        "hive-usage-guard",
        "hive-role-handoff",
        "hive-judge-package",
        "hive-update",
        "hive-project-upgrade",
        "hive-migrate"
      ]
    },
    "skill_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "requires"],
      "properties": {
        "skill": { "$ref": "#/$defs/skill_name" },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/skill_name" }
        }
      }
    }
  }
}
