{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigent-hive.local/schemas/release-bundle-manifest.schema.json",
  "title": "Aigent Hive release bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "release_version", "release_sequence", "classification", "source", "minimum_updater_version", "minimum_supported_harness_version", "license", "surface_inventory_digest", "migration_table_digest", "provenance_digest", "platform_signing_evidence_digest"],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "aigent-hive" },
    "release_version": { "$ref": "#/$defs/version" },
    "release_sequence": { "type": "integer", "minimum": 1 },
    "classification": { "enum": ["feature", "bugfix", "documentation-only", "breaking"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tag"],
      "properties": {
        "repository": { "const": "https://github.com/gvm1229/aigent-hive" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tag": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "minimum_updater_version": { "$ref": "#/$defs/version" },
    "minimum_supported_harness_version": { "$ref": "#/$defs/version" },
    "license": { "const": "Apache-2.0" },
    "surface_inventory_digest": { "$ref": "#/$defs/digest" },
    "migration_table_digest": { "$ref": "#/$defs/digest" },
    "provenance_digest": { "$ref": "#/$defs/digest" },
    "platform_signing_evidence_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
