{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hive knowledge-transfer merge review",
  "type": "object",
  "required": ["schema_version", "merge_preview_digest", "decisions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "merge_preview_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "decisions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["action", "candidate_id"],
            "additionalProperties": false,
            "properties": {
              "action": { "const": "separate" },
              "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          },
          {
            "type": "object",
            "required": ["action", "candidate_id", "primary_path"],
            "additionalProperties": false,
            "properties": {
              "action": { "const": "equivalent" },
              "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "primary_path": { "type": "string", "minLength": 1, "maxLength": 240 }
            }
          },
          {
            "type": "object",
            "required": ["action", "path", "selected_sha256"],
            "additionalProperties": false,
            "properties": {
              "action": { "const": "choose" },
              "path": { "type": "string", "minLength": 1, "maxLength": 240 },
              "selected_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        ]
      }
    }
  }
}
