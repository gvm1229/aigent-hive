{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigent-hive.local/schemas/platform-signing-evidence.schema.json",
  "title": "Aigent Hive platform signing evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence"],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "artifact_path", "artifact_digest", "scheme", "status"],
        "properties": {
          "platform": { "enum": ["macos", "windows"] },
          "artifact_path": { "type": "string", "minLength": 1, "not": { "pattern": "(^/|(^|/)\\.\\.(/|$)|\\\\)" } },
          "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "scheme": { "enum": ["developer-id", "authenticode"] },
          "status": { "enum": ["verified", "fixture-public-evidence", "external-production-required"] }
        }
      }
    }
  }
}
