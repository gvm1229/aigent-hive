{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/skill-catalog.schema.json",
  "title": "Aigent Hive portable Skill catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": { "const": 1 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "capability": {
      "enum": [
        "filesystem-read",
        "filesystem-write",
        "shell",
        "network",
        "subagents",
        "external-app",
        "memory-read",
        "memory-write",
        "run-state"
      ]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "provided_by",
        "superseded_by_external",
        "invocation_intents",
        "side_effect_class",
        "capabilities",
        "availability"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\r\\n]+$"
        },
        "provided_by": {
          "enum": ["hive", "omx", "omc", "host-native"]
        },
        "superseded_by_external": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(omx|omc):[a-z][a-z0-9-]{1,62}$"
          }
        },
        "invocation_intents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
          }
        },
        "side_effect_class": {
          "enum": [
            "none",
            "read-only",
            "project-write",
            "external-write",
            "orchestration"
          ]
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "availability": {
          "enum": ["implemented", "catalog-only"]
        }
      }
    }
  }
}
