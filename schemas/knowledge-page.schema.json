{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/knowledge-page.schema.json",
  "title": "Aigent Hive active Wiki page frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "summary",
    "tags",
    "aliases",
    "sources",
    "links",
    "contradictions",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,78}[a-z0-9])?$"
    },
    "kind": {
      "enum": [
        "source-summary",
        "entity",
        "concept",
        "comparison",
        "synthesis",
        "open-question"
      ]
    },
    "summary": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
      }
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^raw:\\.hive/knowledge/Raw/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?/[0-9a-f]{64}\\.[A-Za-z0-9]+#sha256:[0-9a-f]{64}$"
      }
    },
    "source_links": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "links": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,78}[a-z0-9])?$"
      }
    },
    "related_concepts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,78}[a-z0-9])?$" }
    },
    "duplicate_of": { "type": ["string", "null"], "pattern": "^[a-z0-9](?:[a-z0-9-]{0,78}[a-z0-9])?$" },
    "topics": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" }
    },
    "replacement": { "type": ["string", "null"], "pattern": "^[a-z0-9](?:[a-z0-9-]{0,78}[a-z0-9])?$" },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_a", "source_b", "summary"],
        "properties": {
          "source_a": { "type": "string", "minLength": 1 },
          "source_b": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "status": {
      "enum": ["active", "contradicted", "open-question", "superseded", "expired", "revoked"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
