{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/judge-package.schema.json",
  "title": "Aigent Hive independent judge package",
  "description": "Clean-context judge input. package_digest is SHA-256 over the RFC 8785/JCS encoding of this object with package_digest excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_id",
    "risk_tier",
    "goal",
    "acceptance_criteria",
    "artifact_refs",
    "evidence_refs",
    "known_constraints",
    "package_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "risk_tier": { "enum": ["normal", "elevated", "critical"] },
    "goal": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "known_constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "package_digest": {
      "type": "string",
      "description": "sha256 digest of the RFC 8785/JCS object containing every package field except package_digest",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
