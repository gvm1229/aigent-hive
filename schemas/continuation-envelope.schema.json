{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/continuation-envelope.schema.json",
  "title": "Aigent Hive host-neutral continuation envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_revision",
    "outer_owner",
    "session_binding",
    "next_action",
    "retry_budget",
    "cancel",
    "task_launch",
    "spawned"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,126}$"
    },
    "run_revision": { "type": "integer", "minimum": 1 },
    "outer_owner": {
      "type": ["object", "null"]
    },
    "session_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_state", "host", "session_id_digest"],
      "properties": {
        "binding_state": { "const": "awaiting-host-attestation" },
        "host": { "type": ["string", "null"], "enum": ["codex", "claude", "antigravity", null] },
        "session_id_digest": { "type": "null" }
      }
    },
    "next_action": { "type": ["string", "null"] },
    "retry_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "maximum_attempts", "attempts_used", "remaining_attempts", "retry_permitted"],
      "properties": {
        "state": { "const": "not-configured" },
        "maximum_attempts": { "type": "null" },
        "attempts_used": { "type": "null" },
        "remaining_attempts": { "type": "null" },
        "retry_permitted": { "const": false }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "user_interrupt_permitted"],
      "properties": {
        "state": { "enum": ["not-cancelled", "cancelled"] },
        "user_interrupt_permitted": { "const": true }
      }
    },
    "task_launch": { "const": "host-owned" },
    "spawned": { "const": false }
  }
}
