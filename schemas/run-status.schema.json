{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/run-status.schema.json",
  "title": "Aigent Hive run status frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "revision",
    "state",
    "required_criteria",
    "passed_criteria",
    "failed_criteria",
    "active_roles",
    "next_action",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,126}$"
    },
    "revision": { "type": "integer", "minimum": 1 },
    "state": {
      "enum": [
        "planned",
        "executing",
        "verifying",
        "blocked",
        "usage-limited",
        "resume-ready",
        "succeeded",
        "cancelled"
      ]
    },
    "required_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "passed_criteria": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "failed_criteria": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "blocked_criteria": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "active_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "next_action": {
      "type": ["string", "null"]
    },
    "latest_evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blocker": {
      "type": ["string", "null"]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "enum": ["codex", "claude", "antigravity"]
    },
    "host_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "surface": {
      "enum": ["app", "cli", "plugin", "in-session"]
    },
    "external_runtime": {
      "type": ["string", "null"],
      "enum": ["omx", "omc", null]
    },
    "resolved_owner": {
      "enum": ["host-native", "omx", "omc"]
    },
    "resolution_evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subagent_support": {
      "enum": ["supported", "best-effort", "unsupported", "unverified"]
    },
    "resume_note": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000]+$"
    },
    "criterion_evidence": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/evidenceLocator"
        }
      }
    },
    "continuation": {
      "$ref": "#/$defs/continuation"
    }
  },
  "$defs": {
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_binding_digest", "max_retry_attempts", "attempts_used", "cancel_requested"],
      "properties": {
        "session_binding_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "max_retry_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "attempts_used": { "type": "integer", "minimum": 0, "maximum": 3 },
        "cancel_requested": { "type": "boolean" }
      }
    },
    "evidenceLocator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000\\r\\n]+$"
    }
  }
}
