{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/run-status.schema.json",
  "title": "Aigent Hive run status frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "revision",
    "state",
    "required_criteria",
    "passed_criteria",
    "failed_criteria",
    "active_roles",
    "next_action",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,126}$"
    },
    "revision": { "type": "integer", "minimum": 1 },
    "state": {
      "enum": [
        "planned",
        "executing",
        "verifying",
        "blocked",
        "usage-limited",
        "resume-ready",
        "succeeded",
        "cancelled"
      ]
    },
    "required_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "passed_criteria": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "failed_criteria": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "active_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "next_action": {
      "type": ["string", "null"]
    },
    "latest_evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blocker": {
      "type": ["string", "null"]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
