{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/knowledge-remember-request.schema.json",
  "title": "Aigent Hive knowledge remember request",
  "description": "Bounded, idempotent typed-claim input. Provenance accepts reviewed user statements or reviewed artifacts, never raw transcripts or raw tool output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collection_id",
    "claim_key",
    "locator",
    "kind",
    "status",
    "visibility",
    "normalized_fact",
    "provenance"
  ],
  "properties": {
    "collection_id": { "$ref": "#/$defs/collection_id" },
    "claim_key": { "$ref": "#/$defs/bounded_256" },
    "claim_id": { "$ref": "#/$defs/claim_id" },
    "locator": { "$ref": "#/$defs/portable_locator" },
    "kind": { "$ref": "#/$defs/claim_kind" },
    "status": {
      "enum": ["user-stated", "observed", "verified", "inferred", "conflicted"]
    },
    "visibility": {
      "enum": ["shared", "project-private", "confidential"]
    },
    "normalized_fact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001f\\u007f])[\\s\\S]+$"
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "sources": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/bounded_2048" }
    },
    "supersedes": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/claim_id" }
    },
    "expected_active_digest": { "$ref": "#/$defs/sha256" },
    "observed_at": { "type": "string", "format": "date-time", "maxLength": 64 },
    "verified_at": { "type": "string", "format": "date-time", "maxLength": 64 }
  },
  "$defs": {
    "collection_id": {
      "type": "string",
      "pattern": "^(?:user-root|collection-[0-9a-f]{64})$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^claim-[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bounded_256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*\\u0000)[\\s\\S]+$"
    },
    "bounded_2048": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*\\u0000)[\\s\\S]+$"
    },
    "portable_locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!\\\\)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\s)(?!.*\\s$)(?!.*\\u0000).+$"
    },
    "claim_kind": {
      "enum": [
        "project-profile",
        "decision",
        "convention",
        "preference",
        "workflow",
        "dependency-evidence",
        "outcome",
        "question"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "summary", "locator", "digest"],
      "properties": {
        "source_kind": { "enum": ["user-statement", "reviewed-artifact"] },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\r\\n\\u0000]).+$"
        },
        "locator": { "$ref": "#/$defs/bounded_2048" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
