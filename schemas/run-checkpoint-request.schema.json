{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/run-checkpoint-request.schema.json",
  "title": "Aigent Hive run checkpoint request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "expected_revision",
    "state",
    "passed_criteria",
    "failed_criteria",
    "active_roles",
    "next_action",
    "latest_evidence",
    "blocker",
    "resume_note",
    "criterion_evidence",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,126}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "state": {
      "enum": [
        "planned",
        "executing",
        "verifying",
        "blocked",
        "usage-limited",
        "resume-ready",
        "succeeded",
        "cancelled"
      ]
    },
    "passed_criteria": {
      "$ref": "#/$defs/criteria"
    },
    "failed_criteria": {
      "$ref": "#/$defs/criteria"
    },
    "active_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,62}$"
      }
    },
    "next_action": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000]+$"
    },
    "latest_evidence": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceLocator"
      }
    },
    "blocker": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000]+$"
    },
    "resume_note": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000]+$"
    },
    "criterion_evidence": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/evidenceLocator"
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "criteria": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      }
    },
    "evidenceLocator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1100,
      "pattern": "^\\.hive/runs/[a-z0-9][a-z0-9-]{1,126}/evidence/[^\\u0000\\r\\n#]+#sha256:[0-9a-f]{64}$"
    }
  }
}
