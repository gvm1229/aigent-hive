{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "budget",
    "budget_metric",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "budget_metric": {
      "enum": [
        "input",
        "input-and-output"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_digest",
          "parent_digest",
          "coverage",
          "cache_in_input",
          "baseline",
          "observations",
          "final_observed",
          "baseline_sequence"
        ],
        "properties": {
          "source_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "parent_digest": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "coverage": {
            "enum": [
              "own",
              "includes-children",
              "unknown"
            ]
          },
          "cache_in_input": {
            "type": "boolean"
          },
          "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "output",
              "cached_input"
            ],
            "properties": {
              "input": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "output": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "cached_input": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            }
          },
          "observations": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sequence",
                "counters"
              ],
              "properties": {
                "sequence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "counters": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "input",
                    "output",
                    "cached_input"
                  ],
                  "properties": {
                    "input": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "output": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "cached_input": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    }
                  }
                }
              }
            }
          },
          "final_observed": {
            "type": "boolean"
          },
          "baseline_sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized host token accounting, not subscription quota"
}
