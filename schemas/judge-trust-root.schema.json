{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/judge-trust-root.schema.json",
  "title": "Aigent Hive external judge trust root",
  "description": "Normalized representation of an agent-write-denied TOML trust root. It contains public verification keys only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trust_root_id",
    "revision",
    "issued_at",
    "keys",
    "root_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "trust_root_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 1 },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "principal_id",
          "purpose",
          "algorithm",
          "public_key",
          "status",
          "valid_from",
          "valid_until"
        ],
        "properties": {
          "key_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "purpose": {
            "enum": [
              "judge-assignment",
              "judge-verdict",
              "judge-approval"
            ]
          },
          "algorithm": { "const": "ed25519" },
          "public_key": {
            "type": "string",
            "pattern": "^ed25519:[0-9a-f]{64}$"
          },
          "status": { "enum": ["active", "revoked"] },
          "valid_from": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        }
      }
    },
    "root_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
