{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/host-orchestration-capability.schema.json",
  "title": "Aigent Hive host orchestration capability snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "captured_at",
    "host",
    "host_version",
    "activation",
    "sources",
    "capabilities",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "host": { "enum": ["codex", "claude", "antigravity"] },
    "host_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "activation": { "const": "default-off" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_discovery",
        "user_scope",
        "project_scope",
        "model_pin",
        "effort_pin",
        "native_dispatch",
        "launch_ack",
        "result_return",
        "cancel",
        "lookup",
        "idempotency",
        "runtime_attestation",
        "fresh_session"
      ],
      "properties": {
        "agent_discovery": { "$ref": "#/$defs/status" },
        "user_scope": { "$ref": "#/$defs/status" },
        "project_scope": { "$ref": "#/$defs/status" },
        "model_pin": { "$ref": "#/$defs/status" },
        "effort_pin": { "$ref": "#/$defs/status" },
        "native_dispatch": { "$ref": "#/$defs/status" },
        "launch_ack": { "$ref": "#/$defs/status" },
        "result_return": { "$ref": "#/$defs/status" },
        "cancel": { "$ref": "#/$defs/status" },
        "lookup": { "$ref": "#/$defs/status" },
        "idempotency": { "$ref": "#/$defs/status" },
        "runtime_attestation": { "$ref": "#/$defs/status" },
        "fresh_session": { "$ref": "#/$defs/status" }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "$defs": {
    "status": {
      "enum": ["supported", "partial", "unsupported", "unverified"]
    }
  }
}
