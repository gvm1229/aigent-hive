{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gvm1229/aigent-hive/schemas/judge-package-request.schema.json",
  "title": "Aigent Hive judge package request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_id",
    "risk_tier",
    "goal",
    "acceptance_criteria",
    "artifact_refs",
    "evidence_refs",
    "known_constraints"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "risk_tier": { "enum": ["normal", "elevated", "critical"] },
    "goal": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:\\.[^./\\\\#]|[^./\\\\#])[^/\\\\#]*(?:/(?:\\.[^./\\\\#]|[^./\\\\#])[^/\\\\#]*)*#sha256:[0-9a-f]{64}$"
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:\\.[^./\\\\#]|[^./\\\\#])[^/\\\\#]*(?:/(?:\\.[^./\\\\#]|[^./\\\\#])[^/\\\\#]*)*#sha256:[0-9a-f]{64}$"
      }
    },
    "known_constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
