schema_version = 1
harness_version = "0.9.0"
source_release_version = "0.9.0"
project_name = {{ project_name | to_json }}
project_kind = {{ project_kind | to_json }}
primary_host = {{ primary_host | to_json }}
external_capability_detection = {{ capability_resolution.detection | to_json }}
resolved_owner = {{ capability_resolution.resolved_owner | to_json }}
resolution_evidence_digest = {{ capability_resolution.evidence_digest | to_json }}
usage_stop_remaining_percent = {{ usage_stop_remaining_percent }}
elevated_judge_quorum = {{ elevated_judge_quorum | to_json }}
critical_judge_quorum = {{ critical_judge_quorum | to_json }}

# Optional Skills are inert until each entry is explicitly approved.
approved_optional_skills_file = ".hive/config/approved-skills.yml"
capability_resolution_file = ".hive/config/capability-resolution.yml"
setup_mode = {{ setup_mode | to_json }}
preference_provenance = {{ preference_provenance | to_json }}
interface_language = {{ interface_language | to_json }}
wiki_enabled = {{ wiki_enabled | to_json }}
wiki_backend = {{ wiki_backend | to_json }}
wiki_language = {{ wiki_language | to_json }}
persona_id = {{ persona_id | to_json }}
usage_guard_enabled = {{ usage_guard_enabled | to_json }}
codexbar_fallback_enabled = {{ codexbar_fallback_enabled | to_json }}
discord_guard_enabled = {{ discord_guard_enabled | to_json }}
discord_message_fields = {{ discord_message_fields | to_json }}
{% if discord_webhook_url_env -%}
discord_webhook_url_env = {{ discord_webhook_url_env | to_json }}
{% endif -%}
selected_project_skills = {{ selected_project_skills | to_json }}
{% if capability_resolution.detection == 'available' and capability_resolution.resolved_owner == 'host-native' and approved_fallback_hooks | length > 0 -%}
approved_fallback_hooks_file = ".hive/config/approved-hooks.yml"
{% endif -%}
role_seed_file = ".hive/config/role-seeds.yml"
knowledge_scope_file = ".hive/config/knowledge-scope.yml"
